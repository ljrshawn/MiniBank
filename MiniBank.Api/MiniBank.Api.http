@baseUrl = http://localhost:5269
# Run Create customer first, then copy its response ID here.
@customerId = 01a09dc9-9de4-72cc-9851-2de28ea4df88
# After creating an account, copy its response ID here.
@accountId = 01a09dca-542e-7c24-a25d-5f9e5e290d3a
# Create a second account, then copy its ID here to receive a transfer.
@toAccountId = 01a0a88e-7a41-7c5a-b2ef-7f1f75484255
# Copy the created transfer's ID here.
@transferId = 01a0a88f-7fd2-7589-aeb4-6b0e6cd43e96

### Register a customer and receive an access token (expiresIn is in seconds)
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "email": "new.customer@example.com",
  "password": "Local-demo-password-2026!",
  "firstName": "New",
  "lastName": "Customer",
  "phoneNumber": "+61 412 345 678"
}

### Create customer — 201 with a Location header
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "firstName": "David",
  "lastName": "Smith",
  "email": "david.smith@example.com",
  "password": "Local-demo-password-2026!",
  "phoneNumber": "+61 412 345 678"
}

### List customers — pageSize defaults to 50 and cannot exceed 100
GET {{baseUrl}}/api/customers?page=1&pageSize=20
Accept: application/json

### Get customer with accounts — 200 (accounts is [] if none), or 404 when the ID is unknown
GET {{baseUrl}}/api/customers/{{customerId}}
Accept: application/json

### Create account for the customer — accountType: 0 Checking, 1 Savings
# Returns 201 with Location: /api/accounts/{id}. All other account fields are server-generated.
# Account numbers have nine digits. Collisions are retried up to five total save attempts; exhaustion returns 503.
POST {{baseUrl}}/api/accounts/customers/{{customerId}}
Content-Type: application/json

{
  "accountType": 1
}

### Get customer again — accounts now includes the created account; no customer PUT is needed
GET {{baseUrl}}/api/customers/{{customerId}}
Accept: application/json

### Get account — use the Location from creation or copy its ID into accountId
GET {{baseUrl}}/api/accounts/{{accountId}}
Accept: application/json

### Deposit — 200 with the saved transaction and resulting balance
# Amount must be > 0 and <= 999999999999, with at most two decimal places.
# Description is optional (maximum 255 characters).
POST {{baseUrl}}/api/accounts/{{accountId}}/deposit
Content-Type: application/json

{
  "amount": 100.50,
  "description": "Opening deposit"
}

### Withdraw — 200, or 400 for insufficient funds; default description is Withdrawal
# Both writes return 404 for a missing account and 409 if the balance changes concurrently.
POST {{baseUrl}}/api/accounts/{{accountId}}/withdraw
Content-Type: application/json

{
  "amount": 25.75
}

### Transaction history — newest first; [] for an account without transactions, 404 if missing
GET {{baseUrl}}/api/accounts/{{accountId}}/transactions
Accept: application/json

### Transfer — 201 with Location: /api/transfers/{id}
# Updates both balances and writes TransferOut / TransferIn entries atomically.
POST {{baseUrl}}/api/transfers
Content-Type: application/json

{
  "fromAccountId": "{{accountId}}",
  "toAccountId": "{{toAccountId}}",
  "amount": 10.25,
  "description": "Savings transfer"
}

### Get transfer — 200, or 404 when the ID is unknown
GET {{baseUrl}}/api/transfers/{{transferId}}
Accept: application/json

### Invalid withdrawal — 400; balance and history are unchanged
POST {{baseUrl}}/api/accounts/{{accountId}}/withdraw
Content-Type: application/json

{
  "amount": -10
}

### Invalid account type — 400; no account is saved
POST {{baseUrl}}/api/accounts/customers/{{customerId}}
Content-Type: application/json

{
  "accountType": 999
}

### Unknown customer — 404; no account is saved
POST {{baseUrl}}/api/accounts/customers/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "accountType": 0
}

### Replace profile — customerStatus is required: 0 Active, 1 Inactive, 2 Suspended
PUT {{baseUrl}}/api/customers/{{customerId}}
Content-Type: application/json

{
  "firstName": "David",
  "lastName": "Jones",
  "email": "david.smith@example.com",
  "taxFileNumber": null,
  "phoneNumber": "+61 412 345 678",
  "customerStatus": 1
}

### Duplicate email — 409, including case differences
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "firstName": "David",
  "lastName": "Smith",
  "email": "DAVID.SMITH@example.com",
  "password": "Local-demo-password-2026!",
  "phoneNumber": "+61 412 345 678"
}

### Invalid input — 400 with validation errors
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Smith",
  "email": "invalid-email",
  "password": "short",
  "phoneNumber": "invalid"
}

### Delete customer — 204, 404 if missing, or 409 if they have accounts
DELETE {{baseUrl}}/api/customers/{{customerId}}

### OpenAPI document — available in Development
GET {{baseUrl}}/openapi/v1.json
Accept: application/json
