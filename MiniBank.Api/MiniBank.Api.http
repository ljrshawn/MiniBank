@baseUrl = http://localhost:5269
# Run Create customer first, then copy its response ID here.
@customerId = 8d88ef05-d974-4a32-9d33-ea2e4c39f964
# After creating an account, copy its response ID here.
@accountId = 01a07f01-8fe0-7a09-98e1-12951a74723b

### Create customer — 201 with a Location header
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "firstName": "David",
  "lastName": "Smith",
  "email": "david.smith@example.com",
  "password": "Local-demo-password-2026!",
  "phoneNumber": "+61 412 345 678"
}

### List customers — pageSize defaults to 50 and cannot exceed 100
GET {{baseUrl}}/api/customers?page=1&pageSize=20
Accept: application/json

### Get customer with accounts — 200 (accounts is [] if none), or 404 when the ID is unknown
GET {{baseUrl}}/api/customers/{{customerId}}
Accept: application/json

### Create account for the customer — accountType: 0 Checking, 1 Savings
# Returns 201 with Location: /api/accounts/{id}. All other account fields are server-generated.
# Account numbers have nine digits. Collisions are retried up to five total save attempts; exhaustion returns 503.
POST {{baseUrl}}/api/accounts/customers/{{customerId}}
Content-Type: application/json

{
  "accountType": 1
}

### Get customer again — accounts now includes the created account; no customer PUT is needed
GET {{baseUrl}}/api/customers/{{customerId}}
Accept: application/json

### Get account — use the Location from creation or copy its ID into accountId
GET {{baseUrl}}/api/accounts/{{accountId}}
Accept: application/json

### Invalid account type — 400; no account is saved
POST {{baseUrl}}/api/accounts/customers/{{customerId}}
Content-Type: application/json

{
  "accountType": 999
}

### Unknown customer — 404; no account is saved
POST {{baseUrl}}/api/accounts/customers/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "accountType": 0
}

### Replace profile — customerStatus is required: 0 Active, 1 Inactive, 2 Suspended
PUT {{baseUrl}}/api/customers/{{customerId}}
Content-Type: application/json

{
  "firstName": "David",
  "lastName": "Jones",
  "email": "david.smith@example.com",
  "taxFileNumber": null,
  "phoneNumber": "+61 412 345 678",
  "customerStatus": 1
}

### Duplicate email — 409, including case differences
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "firstName": "David",
  "lastName": "Smith",
  "email": "DAVID.SMITH@example.com",
  "password": "Local-demo-password-2026!",
  "phoneNumber": "+61 412 345 678"
}

### Invalid input — 400 with validation errors
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "firstName": "",
  "lastName": "Smith",
  "email": "invalid-email",
  "password": "short",
  "phoneNumber": "invalid"
}

### Delete customer — 204, 404 if missing, or 409 if they have accounts
DELETE {{baseUrl}}/api/customers/{{customerId}}

### OpenAPI document — available in Development
GET {{baseUrl}}/openapi/v1.json
Accept: application/json
